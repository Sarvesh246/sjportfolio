# Optional. Without a token the site still works, but GitHub allows only 60 requests/hour
# and per-repo commit counts are skipped (curated numbers are used instead).
GITHUB_TOKEN=

# Whose repos to show. Defaults to Sarvesh246.
GITHUB_USER=

# Owner-only "refresh this project" button. Visit /admin and sign in with this password to see it on
# each project page. Leave unset to switch the feature off. Pick something long.
ADMIN_PASSWORD=

# Address behind the "EMAIL ME" button. Defaults to sarveshvjagtap@gmail.com when empty.
NEXT_PUBLIC_CONTACT_EMAIL=
